# The backend as a Linux service. systemd starts it at boot, restarts it if it crashes, and keeps its logs
# (see them with: sudo journalctl -u spaider -f). setup-server.sh copies this file to /etc/systemd/system/.
#
# gunicorn is the production web server for Flask (python app.py is only for development):
#   --workers 1 --threads 8   one process with 8 threads: the question bank's background runs live in this
#                             process, and the AI calls mostly wait on the network, so threads are enough
#   --timeout 300             live streams (Server-Sent Events) can stay open for a while
#   --bind 0.0.0.0:8000       CloudFront sends /api/* here; the security group lets only CloudFront in

[Unit]
Description=SpAIder backend (Flask + gunicorn)
After=network-online.target
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/spaider/backend
ExecStart=/home/ubuntu/spaider/backend/.venv/bin/gunicorn --workers 1 --threads 8 --timeout 300 --bind 0.0.0.0:8000 --access-logfile - app:app
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
